{
  "name": "PokemonChampionsHelper",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "printTree": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tree.ps1",
    "build:data": "node scripts/build-data.mjs",
    "build:data:sprites": "node scripts/build-data.mjs --sprites",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.4.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vuetify": "^4.1.0",
    "vuetify-nuxt-module": "^0.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@smogon/calc": "^0.12.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.0"
  }
}
